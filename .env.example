# AWS Deployment Environment Configuration
AWS_REGION=us-east-1
ENVIRONMENT=prod
PROJECT_NAME=serverless-claims

# AWS DynamoDB
CLAIMS_DYNAMODB_TABLE=serverless-claims-ledger-prod

# Amazon EventBridge & Messaging
CLAIMS_EVENT_BUS=serverless-claims-events-prod
CLAIMS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:serverless-claims-status-alerts-prod

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AWS Step Functions
STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:serverless-claims-pipeline-prod
